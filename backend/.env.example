# Database URL
# For Supabase PostgreSQL (Replace with your actual Supabase connection string):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# For local development / quick test fallback:
DATABASE_URL=sqlite+aiosqlite:///./ledger.db

# CORS allowed origins (use * for all, or comma-separated list like http://localhost:5173,https://your-site.netlify.app)
CORS_ORIGINS=*
